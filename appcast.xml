            <sparkle:version>1.6.0</sparkle:version>
            <sparkle:shortVersionString>1.6.0</sparkle:shortVersionString>
            <description><![CDATA[
                <h2>New Features</h2>
                <ul>
                    <li><strong>Automatic Updates</strong>: Added built-in update checker powered by Sparkle</li>
                    <li>Check for updates via right-click menu</li>
                    <li>Daily automatic update checks with auto-download support</li>
                </ul>
                <h2>Improvements</h2>
                <ul>
                    <li>Reordered reminder sections: "One-time" now appears before "Overdue"</li>
                </ul>
            ]]></description>
